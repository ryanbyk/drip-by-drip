                {
                  "type": "text",
                  "id": "jH1hF",
                  "name": "Body",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "The seed is the same every time — it’s the soil that changes. I’ve been rocky ground this month: hearing it gladly, then letting it go by lunch.\n\nWant to be the kind of soil that keeps it.",
